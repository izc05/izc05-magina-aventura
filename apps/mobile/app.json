{
  "expo": {
    "name": "Mágina Aventura",
    "slug": "magina-aventura",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "maginaaventura",
    "userInterfaceStyle": "light",
    "backgroundColor": "#2F4A2E",
    "primaryColor": "#2F4A2E",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F4A2E"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isivolt.maginaaventura"
    },
    "android": {
      "package": "com.isivolt.maginaaventura"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
