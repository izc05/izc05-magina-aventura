{
  "name": "@magina-aventura/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "prestart": "pnpm brand:assets",
    "preandroid": "pnpm brand:assets",
    "preios": "pnpm brand:assets",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "qa:verify-product-bundle": "node scripts/verify-phase4c-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@magina-aventura/activity-engine": "workspace:*",
    "@magina-aventura/contracts": "workspace:*",
    "@magina-aventura/offline-sync": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-location": "~56.0.25",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~56.0.27",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
